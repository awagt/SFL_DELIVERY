loadActivityLog();

/* ---------- ORDER ATTEMPT HISTORY ---------- */
document.getElementById('orderLookupInput').addEventListener('input', renderOrderLookup);
function renderOrderLookup(){
  const val = document.getElementById('orderLookupInput').value.trim();
  const result = document.getElementById('orderLookupResult');
  if(!val){ result.innerHTML = ''; return; }
  const dispatchAttempts = batches.filter(b => (b.orders||[]).includes(val));
  const returnAttempts = returns.filter(r => r.orderNumber === val);
  if(dispatchAttempts.length === 0 && returnAttempts.length === 0){
    result.innerHTML = `<div class="empty">No dispatch or return history found for "${escapeHtml(val)}".</div>`;
    return;
  }
  result.innerHTML = `
    <div class="magento-note" style="background:var(--paper-raised); color:var(--ink); border:1.5px solid var(--line);">
      <div style="font-weight:700; margin-bottom:6px;">${dispatchAttempts.length} dispatch attempt(s) · ${returnAttempts.length} return attempt(s)</div>
      ${dispatchAttempts.map(b=>`<div class="ref-row" style="color:var(--ink-soft);">📦 Dispatched ${fmtDateTime(b.createdAt)} — Agent: ${escapeHtml(b.agent)}, Location: ${escapeHtml(b.location)}, by ${escapeHtml(b.dispatcher)}</div>`).join('')}
      ${returnAttempts.map(r=>`<div class="ref-row" style="color:var(--ink-soft);">↩ Returned ${fmtDate(r.returnDate)} — Received by ${escapeHtml(r.receiver)}, brought by ${escapeHtml(r.returnAgent)}</div>`).join('')}
    </div>
  `;
}
</script>
