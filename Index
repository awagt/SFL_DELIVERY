// Both login tabs funnel through here — the Apps Script (not this file) checks
// the username/password against the "USER" sheet tab and tells us the role.
async function attemptLogin(username, password, btnId){
  const btn = document.getElementById(btnId);
  const prevText = btn.textContent;
  btn.disabled = true; btn.textContent = 'Checking...';
  document.getElementById('loginError').textContent = '';
  try{
    const result = await api.login(username, password);
    if(!result || !result.success){
      document.getElementById('loginError').textContent = 'Incorrect username or password. Ask Admin if you need an account.';
      return;
    }
    loginAs(result.name, result.role, result.username || username);
  }catch(e){
    document.getElementById('loginError').textContent = 'Could not reach the server. Check your connection and try again.';
    console.error(e);
  }finally{
    btn.disabled = false; btn.textContent = prevText;
  }
}

function loginAs(name, role, username){
  currentUser = {name, role, username};
