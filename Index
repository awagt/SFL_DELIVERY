    }
    return `
    <div class="batch-card">
      <div class="batch-top">
        <div class="batch-left">
          <div class="batch-info">
            <div class="agent">${escapeHtml(u.name)}</div>
            <div class="meta-line">Username: ${escapeHtml(u.username)}</div>
          </div>
        </div>
        <div class="status-tag ${u.role === 'staff' ? 'matched' : 'unmatched'}">${u.role}</div>
