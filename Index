  `;
  }).join('');
}

window.editUser = (username)=>{ editingUserId = username; renderUsersBoard(); };
window.cancelEditUser = ()=>{ editingUserId = null; renderUsersBoard(); };
window.saveUserEdit = async (username)=>{
  const user = users.find(u=>u.username===username); if(!user) return;
  const newName = document.getElementById('editUserName-'+username).value.trim();
  const newPassword = document.getElementById('editUserPassword-'+username).value;
  const newRole = document.getElementById('editUserRole-'+username).value;
