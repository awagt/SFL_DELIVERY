let editingUserId = null;
function renderUsersBoard(){
  const board = document.getElementById('usersBoard');
  // Admin accounts are managed directly in the sheet, not from this board —
  // keeps anyone from accidentally editing/removing the only Admin login.
  const manageable = users.filter(u => u.role !== 'admin');
