/* ---------- CUSTOM CONFIRM / ALERT (native confirm()/alert() are blocked in this sandbox) ---------- */
function customConfirm(message){
  return new Promise((resolve)=>{
    const overlay = document.createElement('div');
    overlay.className = 'confirm-overlay';
    overlay.innerHTML = `
      <div class="confirm-box">
        <p>${escapeHtml(message)}</p>
        <div class="confirm-actions">
          <button class="btn-cancel">Cancel</button>
          <button class="btn-danger">Delete</button>
        </div>
      </div>
    `;
    document.body.appendChild(overlay);
    const cleanup = (val)=>{ document.body.removeChild(overlay); resolve(val); };
    overlay.querySelector('.btn-cancel').addEventListener('click', ()=>cleanup(false));
    overlay.querySelector('.btn-danger').addEventListener('click', ()=>cleanup(true));
    overlay.addEventListener('click', (e)=>{ if(e.target === overlay) cleanup(false); });
  });
}
function customAlert(message, title){
  return new Promise((resolve)=>{
    const overlay = document.createElement('div');
    overlay.className = 'confirm-overlay';
    overlay.innerHTML = `
      <div class="confirm-box">
        ${title ? `<p style="font-weight:700; margin-bottom:6px;">${escapeHtml(title)}</p>` : ''}
        <p>${escapeHtml(message)}</p>
        <div class="confirm-actions">
          <button class="btn-danger" style="flex:1;">OK</button>
        </div>
      </div>
    `;
    document.body.appendChild(overlay);
    const cleanup = ()=>{ document.body.removeChild(overlay); resolve(true); };
    overlay.querySelector('.btn-danger').addEventListener('click', cleanup);
    overlay.addEventListener('click', (e)=>{ if(e.target === overlay) cleanup(); });
  });
}

/* ---------- MAGENTO SYNC ---------- */
async function loadMagentoIndex(){
  try{
    const result = await api.getMagentoIndex();
    if(result && result.data){
      magentoIndex = JSON.parse(result.data) || {};
      magentoImportedAt = result.importedAt || null;
      updateSyncStatus();
    }
  }catch(e){ console.error(e); /* nothing imported yet */ }
}

function updateSyncStatus(){
  const count = Object.keys(magentoIndex).length;
  const el = document.getElementById('syncStatus');
  if(!el) return;
  if(count === 0){ el.textContent = 'No Magento data imported yet.'; return; }
  el.textContent = `${count} orders indexed · last synced ${magentoImportedAt ? fmtDateTime(magentoImportedAt) : 'unknown'}`;
}

function mergeMagentoRow(row, type){
  let orderNum, entry;
  if(type === 'grid'){
    orderNum = (row['Order #'] || '').trim();
    if(!orderNum) return;
    entry = magentoIndex[orderNum] || {};
    entry.status = entry.status || row['Status'];
    entry.date = entry.date || row['Purchased On'];
    entry.grandTotal = entry.grandTotal != null ? entry.grandTotal : parseCurrency(row['Grand Total']);
    entry.invoiced = entry.invoiced != null ? entry.invoiced : parseCurrency(row['Invoiced']);
    entry.qty = entry.qty != null ? entry.qty : parseInt(row['Qty Ordered'], 10) || null;
    entry.paymentMethod = entry.paymentMethod || row['Payment Method'];
  } else if(type === 'detail'){
    orderNum = (row['ID'] || '').trim();
    if(!orderNum) return;
    entry = magentoIndex[orderNum] || {};
    entry.status = row['Status'] || entry.status;
    entry.date = row['Purchase Date'] || entry.date;
    entry.customer = row['Customer Name'] || row['Bill-to Name'] || entry.customer;
    entry.grandTotal = row['Grand Total (Purchased)'] != null && row['Grand Total (Purchased)'] !== '' ? parseCurrency(row['Grand Total (Purchased)']) : entry.grandTotal;
    entry.invoiced = row['Invoice Total'] != null && row['Invoice Total'] !== '' ? parseCurrency(row['Invoice Total']) : entry.invoiced;
    entry.refunded = parseCurrency(row['Total Refunded']) || entry.refunded || 0;
    entry.location = row['Allocated sources'] || entry.location;
    entry.paymentMethod = row['Payment Method'] || entry.paymentMethod;
    entry.comment = row['Order Comments'] ? String(row['Order Comments']).replace(/\s+/g,' ').trim().slice(0, 300) : entry.comment;
  } else return;
  magentoIndex[orderNum] = entry;
}

function detectFileType(headers){
  if(headers.includes('Order #')) return 'grid';
  if(headers.includes('ID') && headers.includes('Bill-to Name')) return 'detail';
  return 'unknown';
}

function handleMagentoFile(file){
  if(!file) return;
  const name = file.name.toLowerCase();
  if(name.endsWith('.xlsx') || name.endsWith('.xls')){
    const reader = new FileReader();
    reader.onload = (e) => {
      try{
        const data = new Uint8Array(e.target.result);
        const workbook = XLSX.read(data, {type: 'array'});
        const sheet = workbook.Sheets[workbook.SheetNames[0]];
        const rows = XLSX.utils.sheet_to_json(sheet, {defval: ''});
        processMagentoRows(rows, 'Excel');
      }catch(err){
        showToast("Couldn't read that Excel file");
        console.error(err);
      }
    };
    reader.readAsArrayBuffer(file);
  } else {
    Papa.parse(file, {
      header: true,
      skipEmptyLines: true,
      complete: (results) => processMagentoRows(results.data, 'CSV'),
      error: (err)=>{ showToast('Could not parse that CSV file'); console.error(err); }
    });
  }
}

async function processMagentoRows(rows, sourceLabel){
  if(!rows || rows.length === 0){ showToast('No rows found in that file'); return; }
  const headers = Object.keys(rows[0]);
  const type = detectFileType(headers);
  if(type === 'unknown'){
    showToast(`Couldn't recognize that ${sourceLabel} file's columns`);
    return;
  }
  rows.forEach(row => mergeMagentoRow(row, type));
  magentoImportedAt = Date.now();
  try{
    await api.setMagentoIndex(JSON.stringify(magentoIndex), magentoImportedAt);
    updateSyncStatus();
    showToast(`Imported ${rows.length} rows from ${type === 'grid' ? 'Order Grid' : 'Order Detail'} ${sourceLabel} file`);
    renderDScanChips();
    if(document.getElementById('rOrderInput').value.trim()) doLookup();
    if(document.getElementById('panel-reports').classList.contains('active')) renderReports();
  }catch(e){
    showToast('Could not save data. It may be too large.');
    console.error(e);
  }
}

