// Return rows live one-per-SKU in the "SFL Returns" sheet tab, with no ID
// column — rows logged together are grouped back into one card here by
// (Order Number + Return Date + Receiver), which is also how edits/deletes
// find the right rows again (see api.updateReturn / api.deleteReturn).
function groupReturnRows(rows){
  const groups = [];
  const index = {};
  rows.forEach(r=>{
    const key = [r.orderNumber, r.returnDate, r.receiver].join('|||');
    if(!index[key]){
      index[key] = {
        id: 'ret' + groups.length,
        orderNumber: r.orderNumber, returnDate: r.returnDate, receiver: r.receiver,
        returnAgent: r.returnAgent, matched: r.matched, skus: []
      };
      groups.push(index[key]);
    }
    index[key].skus.push({ sku: r.sku, qty: Number(r.qty) || 1 });
  });
  return groups.reverse(); // most recently logged first
}

