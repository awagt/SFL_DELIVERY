  const q = document.getElementById('rSearchInput').value.trim().toLowerCase();
  let filtered = returns.filter(r=>{
    const matchesFilter = rFilter === 'all' || (rFilter === 'matched' && r.matched) || (rFilter === 'unmatched' && !r.matched);
    const hay = [r.orderNumber, r.receiver, r.returnAgent, ...(r.skus||[]).map(s=>s.sku)].join(' ').toLowerCase();
    const matchesSearch = !q || hay.includes(q);
    return matchesFilter && matchesSearch;
  });
  const board = document.getElementById('rBoard');
  if(filtered.length === 0){ board.innerHTML = '<div class="empty">No returns logged yet.</div>'; return; }
  board.innerHTML = filtered.map(r => {
    if(editingReturnId === r.id){
      return `
        <div class="batch-card">
          <div class="batch-top">
            <div class="batch-left">
              <div class="batch-count">${(r.skus||[]).reduce((s,e)=>s+(e.qty||1),0)}</div>
              <div class="batch-info"><div class="agent">Editing return &middot; Order ${escapeHtml(r.orderNumber)}</div></div>
            </div>
          </div>
          <div class="edit-form">
            <input id="editReceiver-${r.id}" value="${escapeHtml(r.receiver)}" placeholder="Receiver">
            <input id="editReturnAgent-${r.id}" value="${escapeHtml(r.returnAgent)}" placeholder="Return agent">
            <input id="editReturnDate-${r.id}" type="date" value="${escapeHtml(r.returnDate)}">
            <div class="edit-actions">
              <button class="btn-save" onclick="saveReturnEdit('${r.id}')">Save</button>
              <button onclick="cancelEditReturn()">Cancel</button>
            </div>
          </div>
        </div>
      `;
    }
    return `
    <div class="batch-card">
      <div class="batch-top" onclick="toggleBatch('ret-${r.id}')">
        <div class="batch-left">
          <div class="batch-count">${(r.skus||[]).reduce((s,e)=>s+(e.qty||1),0)}</div>
          <div class="batch-info">
            <div class="agent">Order ${escapeHtml(r.orderNumber)}</div>
            <div class="meta-line">Received by ${escapeHtml(r.receiver)} &middot; brought by ${escapeHtml(r.returnAgent)} &middot; ${fmtDate(r.returnDate)}</div>
          </div>
        </div>
        <div class="tag-row">
          <div class="status-tag ${r.matched ? 'matched' : 'unmatched'}">${r.matched ? 'Matched' : 'Unmatched'}</div>
        </div>
      </div>
      <div class="batch-orders" id="orders-ret-${r.id}">
        ${(r.skus||[]).map(s=>`<div class="order-chip">${escapeHtml(s.sku)} ${s.qty>1?`<b>×${s.qty}</b>`:''}</div>`).join('')}
      </div>
      <div class="batch-actions">
        <button onclick="toggleBatch('ret-${r.id}')">View SKUs</button>
        ${isAdmin() ? `<button onclick="editReturn('${r.id}')">Edit</button><button onclick="removeReturn('${r.id}')">Delete</button>` : ''}
      </div>
    </div>
  `;
  }).join('');
}
window.editReturn = (id)=>{ editingReturnId = id; renderRBoard(); };
window.cancelEditReturn = ()=>{ editingReturnId = null; renderRBoard(); };
window.saveReturnEdit = async (id)=>{
  const ret = returns.find(r=>r.id===id); if(!ret) return;
  const identity = { orderNumber: ret.orderNumber, returnDate: ret.returnDate, receiver: ret.receiver }; // original, for finding the rows
  const newReceiver = document.getElementById('editReceiver-'+id).value.trim() || ret.receiver;
  const newReturnAgent = document.getElementById('editReturnAgent-'+id).value.trim() || ret.returnAgent;
  const newReturnDate = document.getElementById('editReturnDate-'+id).value || ret.returnDate;
  await api.updateReturn(identity, { 'Receiver': newReceiver, 'Return Agent': newReturnAgent, 'Return Date': newReturnDate });
  editingReturnId = null;
  await loadReturns();
  logActivity('return_edited', `Edited return for order ${ret.orderNumber}`);
  showToast('Return updated');
};

/* ---------- STATS ---------- */
function renderStats(){
  const totalOrders = batches.reduce((s,b)=>s+(b.orders?b.orders.length:0),0);
  document.getElementById('statOrders').textContent = totalOrders;
  document.getElementById('statReturns').textContent = returns.length;
  document.getElementById('statUnmatched').textContent = returns.filter(r=>!r.matched).length;
}

/* ================= REPORTS TAB ================= */
let reportRange = 'all';
document.querySelectorAll('.range-chip').forEach(chip=>{
  chip.addEventListener('click', ()=>{
    document.querySelectorAll('.range-chip').forEach(c=>c.classList.remove('active'));
    chip.classList.add('active');
    reportRange = chip.dataset.range;
    renderReports();
  });
});

function withinRange(ts){
  if(reportRange === 'all') return true;
  const days = parseInt(reportRange, 10);
  const cutoff = Date.now() - days * 24 * 60 * 60 * 1000;
  return ts >= cutoff;
}

function renderReports(){
  const rBatches = batches.filter(b => withinRange(b.createdAt));
  const rReturns = returns.filter(r => withinRange(r.createdAt));
  const returnedSet = new Set(returns.map(r=>r.orderNumber));

  const totalOrders = rBatches.reduce((s,b)=>s+(b.orders?b.orders.length:0),0);
  const totalDelivered = rBatches.filter(b=>b.status==='delivered').reduce((s,b)=>s+(b.orders?b.orders.length:0),0);
  const totalReturns = rReturns.length;
  const returnRate = totalOrders > 0 ? ((rBatches.reduce((s,b)=>s+(b.orders||[]).filter(o=>returnedSet.has(o)).length,0) / totalOrders) * 100).toFixed(1) : '0.0';
  const uniqueAgents = new Set(rBatches.map(b=>b.agent)).size;

  let totalValue = 0, valuedCount = 0;
  const flaggedRows = [];
  rBatches.forEach(b=>{
    (b.orders||[]).forEach(o=>{
      const m = magentoIndex[o];
      if(m && m.grandTotal != null){ totalValue += m.grandTotal; valuedCount++; }
      if(m && isFlaggedStatus(m.status)){
        flaggedRows.push({order:o, status:m.status, batch:b, value:m.grandTotal});
      }
    });
  });
  const avgValue = valuedCount > 0 ? (totalValue / valuedCount).toFixed(2) : '0.00';

  document.getElementById('summaryGrid').innerHTML = `
    <div class="summary-card"><div class="n">${rBatches.length}</div><div class="l">Batches</div></div>
    <div class="summary-card"><div class="n">${totalOrders}</div><div class="l">Orders Dispatched</div></div>
    <div class="summary-card"><div class="n">${totalDelivered}</div><div class="l">Delivered</div></div>
    <div class="summary-card"><div class="n">${totalReturns}</div><div class="l">Returns</div></div>
    <div class="summary-card"><div class="n">${returnRate}%</div><div class="l">Return Rate</div></div>
    <div class="summary-card"><div class="n">${uniqueAgents}</div><div class="l">Active Agents</div></div>
    ${Object.keys(magentoIndex).length > 0 ? `
    <div class="summary-card"><div class="n">QR ${totalValue.toFixed(0)}</div><div class="l">Dispatched Value</div></div>
    <div class="summary-card"><div class="n">QR ${avgValue}</div><div class="l">Avg Order Value</div></div>
    ` : ''}
  `;

  renderBreakdownTable('agentTable', rBatches, b => b.agent, b => (b.orders||[]).length, 'Agent', 'Orders');
  renderBreakdownTable('locationTable', rBatches, b => b.location, b => (b.orders||[]).length, 'Location', 'Orders');
  renderBreakdownTable('returnAgentTable', rReturns, r => r.returnAgent, r => (r.skus||[]).reduce((s,e)=>s+(e.qty||1),0), 'Return Agent', 'Items');

  const flaggedTable = document.getElementById('flaggedTable');
  if(flaggedRows.length === 0){
    flaggedTable.innerHTML = `<tbody><tr><td style="color:var(--ink-soft); font-size:12.5px;">${Object.keys(magentoIndex).length === 0 ? 'Import Magento data above to enable this check.' : 'No flagged orders in this range.'}</td></tr></tbody>`;
  } else {
    flaggedTable.innerHTML = `
      <thead><tr><th>Order</th><th>Magento Status</th><th>Delivery Agent</th><th>Value</th></tr></thead>
      <tbody>
        ${flaggedRows.map(f => `
          <tr>
            <td>${escapeHtml(f.order)}</td>
            <td><span class="status-tag ${f.status.toLowerCase().includes('cancel') ? 'canceled' : 'refunded'}">${escapeHtml(f.status)}</span></td>
            <td>${escapeHtml(f.batch.agent)}</td>
            <td>${f.value != null ? 'QR ' + f.value : '—'}</td>
          </tr>
        `).join('')}
      </tbody>
    `;
  }
}

function renderBreakdownTable(tableId, rows, keyFn, countFn, keyLabel, countLabel){
  const counts = {};
  rows.forEach(row=>{
    const key = keyFn(row) || 'Unknown';
    counts[key] = (counts[key] || 0) + countFn(row);
  });
  const entries = Object.entries(counts).sort((a,b)=>b[1]-a[1]);
  const max = entries.length ? entries[0][1] : 1;
  const tbody = document.querySelector('#' + tableId + ' tbody');
  if(entries.length === 0){
    document.querySelector('#' + tableId).innerHTML = `<tbody><tr><td style="color:var(--ink-soft); font-size:12.5px;">No data for this range.</td></tr></tbody>`;
    return;
  }
  document.querySelector('#' + tableId).innerHTML = `
    <thead><tr><th>${keyLabel}</th><th>${countLabel}</th><th></th></tr></thead>
    <tbody>
      ${entries.map(([k,v])=>`
        <tr>
          <td>${escapeHtml(k)}</td>
          <td>${v}</td>
          <td><div class="bar-cell"><div class="bar-track"><div class="bar-fill" style="width:${(v/max*100).toFixed(0)}%"></div></div></div></td>
        </tr>
      `).join('')}
    </tbody>
  `;
}

function csvEscape(val){
  const s = String(val == null ? '' : val);
  if(/[",\n]/.test(s)) return '"' + s.replace(/"/g,'""') + '"';
  return s;
}
function downloadCSV(filename, rows){
  const csv = rows.map(r => r.map(csvEscape).join(',')).join('\r\n');
  const blob = new Blob([csv], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

document.getElementById('exportDispatchBtn').addEventListener('click', ()=>{
  const returnedSet = new Set(returns.map(r=>r.orderNumber));
  const hasMagento = Object.keys(magentoIndex).length > 0;
  const header = ['Order Number','Batch ID','Dispatch Date','Dispatcher','Delivery Agent','Dispatch Location','Status','Returned'];
  if(hasMagento) header.push('Customer','Order Value','Magento Status');
  const rows = [header];
  batches.filter(b=>withinRange(b.createdAt)).forEach(b=>{
    (b.orders||[]).forEach(o=>{
      const row = [o, b.id, fmtDateTime(b.createdAt), b.dispatcher, b.agent, b.location, b.status, returnedSet.has(o) ? 'Yes' : 'No'];
      if(hasMagento){
        const m = magentoIndex[o];
        row.push(m ? (m.customer || '') : '', m && m.grandTotal != null ? m.grandTotal : '', m ? (m.status || '') : '');
      }
      rows.push(row);
    });
  });
  if(rows.length === 1){ showToast('No dispatch data to export'); return; }
  downloadCSV('dispatch_export_' + todayStr() + '.csv', rows);
  showToast('Dispatch CSV downloaded');
});

document.getElementById('exportReturnsBtn').addEventListener('click', ()=>{
  const rows = [['Order Number','SKU','QTY','Return Date','Receiver','Return Agent','Matched to Dispatch']];
  returns.filter(r=>withinRange(r.createdAt)).forEach(r=>{
    (r.skus||[]).forEach(s=>{
      rows.push([r.orderNumber, s.sku, s.qty, fmtDate(r.returnDate), r.receiver, r.returnAgent, r.matched ? 'Yes' : 'No']);
    });
  });
  if(rows.length === 1){ showToast('No return data to export'); return; }
  downloadCSV('returns_export_' + todayStr() + '.csv', rows);
  showToast('Returns CSV downloaded');
});

