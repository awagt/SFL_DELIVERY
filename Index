            <select id="editUserRole-${u.username}">
              <option value="staff" ${u.role==='staff'?'selected':''}>Normal user (add &amp; view)</option>
              <option value="guest" ${u.role==='guest'?'selected':''}>Guest (view only)</option>
            </select>
