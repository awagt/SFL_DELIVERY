// Dispatch rows live one-per-order in the "SFL Dispatch" sheet tab; group them
// back into batch cards here (several orders scanned together share a Batch ID).
function groupDispatchRows(rows){
  const byBatch = {};
  const order = [];
  rows.forEach(r=>{
    if(!byBatch[r.batchId]){
      byBatch[r.batchId] = {
        id: r.batchId, orders: [],
        dispatcher: r.dispatcher, agent: r.agent, location: r.location, status: r.status,
        createdAt: Date.parse(r.dispatchDate) || 0
      };
      order.push(r.batchId);
    }
    byBatch[r.batchId].orders.push(r.orderNumber);
  });
  return order.map(id=>byBatch[id]).sort((a,b)=> (b.createdAt||0) - (a.createdAt||0));
}

