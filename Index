<script>
/* =====================================================================
   STEP A: PASTE YOUR GOOGLE APPS SCRIPT WEB APP URL HERE.

   This app has no database of its own — every read and write below
   goes straight to the real tabs in your Google Sheet (SFL Dispatch,
   SFL Returns, USER, DELIVERY AGENT, DISPATCH LOCATION, plus a LOG
   tab the script manages for you). Nothing is cached or hidden.
   ===================================================================== */
const SHEET_API_URL = "https://script.google.com/macros/s/AKfycbzgJRwVlXMhsLA8-yv8eYAuyAGCiXawvxGJZzQoThc35l--tWO-o7cpzq3gbH6Eo7aT/exec";

async function apiGet(action, params){
  const qs = new URLSearchParams({ action, ...(params||{}) }).toString();
  const res = await fetch(`${SHEET_API_URL}?${qs}`);
  const data = await res.json();
  if(data && data.error) throw new Error(data.error);
  return data;
}
async function apiPost(action, payload){
  // mode:'no-cors' + text/plain avoids Apps Script's CORS preflight, which it
  // doesn't support — the request still reaches the script and runs fine,
  // we just can't read a response body back (doPost's reply is one-way here).
  await fetch(SHEET_API_URL, {
    method: 'POST',
    mode: 'no-cors',
    headers: {'Content-Type': 'text/plain'},
    body: JSON.stringify({ action, ...payload })
  });
}

const api = {
  // Accounts & login — the password/PIN never lives in this HTML file. Every
  // login attempt is checked by the Apps Script against the USER sheet tab,
  // which only ever answers with yes/no + the account's name and role.
  login: (username, password) => apiGet('login', { username, password }),
  listUsers: async () => (await apiGet('listUsers')).items || [],
  upsertUser: (user) => apiPost('upsertUser', { user }),
  deleteUser: (username) => apiPost('deleteUser', { username }),

  listDispatch: async () => (await apiGet('listDispatch')).items || [],
  addDispatch: (batch) => apiPost('addDispatch', { batch }),
  updateDispatch: (batchId, patch) => apiPost('updateDispatch', { batchId, patch }),
  deleteDispatch: (batchId) => apiPost('deleteDispatch', { batchId }),

  listReturns: async () => (await apiGet('listReturns')).items || [],
  addReturn: (ret) => apiPost('addReturn', { ret }),
  updateReturn: (identity, patch) => apiPost('updateReturn', { identity, patch }),
  deleteReturn: (identity) => apiPost('deleteReturn', { identity }),

  listAgents: async () => (await apiGet('listAgents')).items || [],
  listLocations: async () => (await apiGet('listLocations')).items || [],

  addLog: (entry) => apiPost('addLog', { entry }),
  listLog: async () => (await apiGet('listLog')).items || [],

  getMagentoIndex: () => apiGet('getMagentoIndex'),
  setMagentoIndex: (data, importedAt) => apiPost('setMagentoIndex', { data, importedAt })
};
/* ===================== END OF SETUP SECTION ===================== */

let batches = [];
let returns = [];
let dScanned = [];
let rSkus = [];
let dFilter = 'all';
let rFilter = 'all';
let magentoIndex = {}; // orderNumber -> {status, date, customer, grandTotal, invoiced, refunded, qty, location}
let magentoImportedAt = null;

const toast = document.getElementById('toast');
function showToast(msg){ toast.textContent = msg; toast.classList.add('show'); setTimeout(()=>toast.classList.remove('show'), 1800); }
function fmtDateTime(ts){ const dt = new Date(ts); return dt.toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) + ' ' + dt.toLocaleTimeString('en-US', {hour:'numeric', minute:'2-digit'}); }
function fmtDate(d){ if(!d) return '—'; const dt = new Date(d + 'T00:00:00'); if(isNaN(dt)) return d; return dt.toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}); }
function escapeHtml(str){ if(!str) return ''; return String(str).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m])); }
function todayStr(){ return new Date().toISOString().slice(0,10); }
function parseCurrency(str){ if(!str) return null; const n = parseFloat(String(str).replace(/[^0-9.\-]/g,'')); return isNaN(n) ? null : n; }
function isFlaggedStatus(status){
  if(!status) return false;
  const s = status.toLowerCase();
  return s.includes('cancel') || s.includes('refund') || s.includes('closed') || s.includes('exchang');
}

let currentUser = null; // {name, role: 'admin'|'staff'|'guest', username}
let editingBatchId = null;
let editingReturnId = null;
let users = []; // {name, username, role, status} — loaded from the sheet; never holds a password
